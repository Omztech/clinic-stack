          "mode": "list",
          "cachedResultName": "Gemini 3.5 Flash Lite"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a data extractor. Read the ANSWER below and return JSON only, with no other text, in exactly this shape:\n{\"clinics\":[{\"name\":\"\",\"position\":1,\"location\":\"\"}],\"sources\":[]}\n\nRules:\n- List every clinic, hospital, salon or shop that the answer recommends as a place to get a treatment or a consultation, in the order each one first appears. position starts at 1.\n- Write each name exactly as the answer writes it, without extra words in brackets such as (Leeds) or (Leeds Clinic).\n- location is the area or street the answer gives for that place, or \"\" if none.\n- Do not include product brands, devices, regulators or organisations, for example Obagi, Dermapen, Candela, Medik8, CQC, Save Face, NHS.\n- sources is a list of any website links written in the answer, or [] if there are none.\n- Do not add anything that is not in the answer.\n\nANSWER:\n{{ $json.answer }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "8a0b87ca-a6cb-4058-a5e2-642a9aa83cfe",
      "name": "Message a model",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000,
      "credentials": {
        "googlePalmApi": {
          "id": "XrZOjR590GqmFt3Z",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst id = $('Loop Over Items').first().json.id;\n\nlet raw = '';\ntry { raw = item.content.parts[0].text; } catch (e) { raw = ''; }\n\nconst cleaned = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet extracted;\ntry {\n  const p = JSON.parse(cleaned);\n  if (!Array.isArray(p.clinics)) throw new Error('no clinics list');\n  extracted = {\n    status: 'ok',\n    clinics: p.clinics,\n    sources: Array.isArray(p.sources) ? p.sources : []\n  };\n} catch (e) {\n  extracted = { status: 'retry', error: String(e.message || e) };\n}\n\nreturn [{ json: { id: id, extracted: JSON.stringify(extracted) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "9a312e49-b348-472a-996b-049c2b28d874",
